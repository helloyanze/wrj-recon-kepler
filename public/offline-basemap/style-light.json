      "id": "boundaries",
      "type": "line",
      "source": "protomaps",
      "source-layer": "boundaries",
      "paint": {
        "line-color": "#bdb8ae",
        "line-width": 1,
        "line-dasharray": [
          3,
          2
        ],
        "line-opacity": 0.6
      }
    },
    {
      "id": "water-area-labels",
      "type": "symbol",
      "source": "protomaps",
      "source-layer": "physical_point",
      "minzoom": 7,
      "filter": [
        "in",
        [
          "get",
          "pmap:kind"
        ],
        [
          "literal",
          [
            "sea",
            "strait",
            "bay",
            "lake",
            "water"
          ]
        ]
      ],
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:zh"
          ],
          [
            "get",
            "name"
          ],
          [
            "get",
            "name:en"
          ],
          ""
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          7,
          10,
          12,
          12,
          16,
          14
        ],
        "text-letter-spacing": 0.06,
        "text-max-width": 8,
        "text-padding": 4,
        "text-allow-overlap": false
      },
      "paint": {
        "text-color": "#3c6d8c",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.2,
        "text-opacity": 0.92
