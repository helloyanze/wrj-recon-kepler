{
  "version": 8,
  "name": "WRJ Offline Light",
  "glyphs": "/offline-basemap/glyphs/{fontstack}/{range}.pbf",
  "sources": {
    "protomaps": {
      "type": "vector",
      "tiles": [
        "/offline-basemap/tiles/{z}/{x}/{y}.mvt"
      ],
      "minzoom": 4,
      "maxzoom": 14,
      "attribution": "© OpenStreetMap contributors · Protomaps"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#eceae4"
      }
    },
    {
      "id": "earth",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "earth",
      "paint": {
        "fill-color": "#f6f4ef"
      }
    },
    {
      "id": "natural",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "natural",
      "paint": {
        "fill-color": [
          "match",
          [
            "get",
            "pmap:kind"
          ],
          "wood",
          "#dce8d4",
          "scrub",
          "#dce8d4",
          "sand",
          "#f1e9d4",
          "beach",
          "#f1e9d4",
          "glacier",
          "#eceae4",
          "#dce8d4"
        ]
      }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "landuse",
      "paint": {
        "fill-color": [
          "match",
          [
            "get",
            "pmap:kind"
          ],
          "park",
          "#dcead5",
          "national_park",
          "#dcead5",
          "nature_reserve",
          "#dcead5",
          "wood",
          "#dce8d4",
          "forest",
          "#dce8d4",
          "beach",
          "#f1e9d4",
          "sand",
          "#f1e9d4",
          "farmland",
          "#eef0e3",
          "farm",
          "#eef0e3",
          "commercial",
          "#f0ece6",
          "industrial",
          "#eae8e3",
          "railway",
          "#eae8e3",
          "residential",
          "#efede8",
          "#efede8"
        ],
        "fill-opacity": 0.85
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "water",
      "paint": {
        "fill-color": "#d5e3ea"
      }
    },
    {
      "id": "physical-line",
      "type": "line",
      "source": "protomaps",
      "source-layer": "physical_line",
      "paint": {
        "line-color": "#c9dce6",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          9,
          0.4,
          14,
          1.8
        ]
      }
    },
    {
      "id": "transit",
      "type": "line",
      "source": "protomaps",
      "source-layer": "transit",
      "minzoom": 11,
      "paint": {
        "line-color": "#cfcac1",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          11,
          0.6,
          14,
          1.5
        ],
        "line-dasharray": [
          2,
          2
        ]
      }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "buildings",
      "minzoom": 14,
      "paint": {
        "fill-color": "#e2ded5"
      }
    },
    {
      "id": "roads-casing",
      "type": "line",
      "source": "protomaps",
      "source-layer": "roads",
      "paint": {
        "line-color": "#d4d0c7",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.5
          ],
          [
            "zoom"
          ],
          9,
          [
            "match",
            [
              "get",
              "pmap:kind"
            ],
            "highway",
            2.7,
            "medium_road",
            2.3,
            "minor_road",
            2.0500000000000003,
            1.9000000000000001
          ],
          14,
          [
            "match",
            [
              "get",
              "pmap:kind"
            ],
            "highway",
            7.1,
            "medium_road",
            4.4,
            "minor_road",
            3,
            2.5
          ]
        ],
        "line-opacity": 0.85
      }
    },
    {
      "id": "roads",
      "type": "line",
      "source": "protomaps",
      "source-layer": "roads",
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": [
          "match",
          [
            "get",
            "pmap:kind"
          ],
          "highway",
          "#fffdf7",
          "medium_road",
          "#ffffff",
          "#ffffff"
        ],
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.5
          ],
          [
            "zoom"
          ],
          9,
          [
            "match",
            [
              "get",
              "pmap:kind"
            ],
            "highway",
            1.1,
            "medium_road",
            0.7,
            "minor_road",
            0.45,
            0.3
          ],
          14,
          [
            "match",
            [
              "get",
              "pmap:kind"
            ],
            "highway",
            5.5,
            "medium_road",
            2.8,
            "minor_road",
            1.4,
            0.9
          ]
        ]
      }
    },
