{
  "name": "wrj-recon-kepler-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "data:fetch-real": "node scripts/fetch-real-geodata.mjs",
    "data:normalize-real": "node scripts/normalize-osm-features.mjs",
    "data:generate-simulated": "node scripts/generate-simulated-mission.mjs",
    "data:validate": "node scripts/validate-case-data.mjs",
    "data:prepare": "npm run data:fetch-real && npm run data:generate-simulated && npm run data:validate",
    "data:prepare-algorithm": "vite-node --script scripts/prepare-algorithm-cases.ts",
    "data:check-algorithm": "vite-node --script scripts/prepare-algorithm-cases.ts --check",
    "data:snapshot-backend": "vite-node --script scripts/snapshot-backend-run.ts",
    "data:prepare-task2": "vite-node --script scripts/prepare-task2-scenes.ts",
    "data:check-task2": "vite-node --script scripts/prepare-task2-scenes.ts --check"
  },
  "engines": {
    "node": ">=20 <21"
  },
  "dependencies": {
    "@deck.gl/core": "8.9.36",
    "@deck.gl/geo-layers": "8.9.36",
    "@deck.gl/layers": "8.9.36",
    "@kepler.gl/actions": "3.2.6",
    "@kepler.gl/components": "3.2.6",
    "@kepler.gl/processors": "3.2.6",
    "@kepler.gl/reducers": "3.2.6",
    "@kepler.gl/schemas": "3.2.6",
    "@kepler.gl/types": "3.2.6",
    "fflate": "0.8.2",
    "idb": "8.0.3",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-palm": "3.3.11",
    "react-redux": "8.1.3",
    "redux": "4.2.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "9.16.0",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.16.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "0.4.16",
    "jsdom": "25.0.1",
    "typescript": "5.6.3",
    "typescript-eslint": "8.17.0",
    "vite": "5.4.21",
    "vitest": "2.1.8"
  }
}
